cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/Dependencies.cmake")
set(root "${CMAKE_CURRENT_LIST_DIR}/../.deps")
file(MAKE_DIRECTORY "${root}/downloads")

function(fetch_file url expected path)
  if(NOT EXISTS "${path}")
    file(DOWNLOAD "${url}" "${path}.part"
      EXPECTED_HASH "SHA256=${expected}" TLS_VERIFY ON
      TIMEOUT 240 INACTIVITY_TIMEOUT 30)
    file(RENAME "${path}.part" "${path}")
  endif()
  file(SHA256 "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "SHA-256 mismatch for ${path}. Replace it with the pinned upstream file.")
  endif()
endfunction()

function(fetch_archive name url expected destination)
  set(archive "${root}/downloads/${name}")
  fetch_file("${url}" "${expected}" "${archive}")
  if(NOT EXISTS "${destination}/.extracted-${expected}")
    file(MAKE_DIRECTORY "${destination}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
    file(TOUCH "${destination}/.extracted-${expected}")
  endif()
endfunction()

set(models "${root}/models/voxlock-v2")
file(MAKE_DIRECTORY "${models}")
function(fetch_model filename expected)
  fetch_file("${VOXLOCK_V2_BASE}/voxlock_${filename}" "${expected}" "${models}/${filename}")
endfunction()

fetch_model(enroll.onnx "${VOXLOCK_V2_ENROLL_SHA256}")
fetch_model(chunk_int8.onnx "${VOXLOCK_V2_CHUNK_SHA256}")
if(VOICEISOLATOR_CUDA OR VOICEISOLATOR_MODEL_VARIANTS)
  fetch_model(chunk.onnx "${VOXLOCK_V2_CHUNK_FP32_SHA256}")
endif()
if(VOICEISOLATOR_MODEL_VARIANTS)
  fetch_model(chunk_int8_full.onnx "${VOXLOCK_V2_CHUNK_INT8_FULL_SHA256}")
  fetch_model(enroll_fp16.onnx "${VOXLOCK_V2_ENROLL_FP16_SHA256}")
  fetch_model(chunk_fp16.onnx "${VOXLOCK_V2_CHUNK_FP16_SHA256}")
endif()
if(VOICEISOLATOR_CUDA)
  fetch_archive("${ORT_CUDA_ARCHIVE}" "${ORT_CUDA_URL}" "${ORT_CUDA_SHA256}" "${root}/onnxruntime")
endif()
if(VOICEISOLATOR_TEST_FIXTURES)
  fetch_archive("${VOXLOCK_FIXTURE_ARCHIVE}" "${VOXLOCK_FIXTURE_URL}"
    "${VOXLOCK_FIXTURE_SHA256}" "${root}/models")
endif()
